{
  "name": "cozy-creations-by-autumn",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check:types": "tsc --noEmit",
    "check:release": "npm run check:assets && npm run check:purchases && npm run check:experience && npm run check:types && npm run build && node scripts/check-build-output.mjs",
    "format": "bun fmt .",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check:assets": "node scripts/check-catalog-assets.mjs",
    "check:purchases": "node scripts/check-purchase-links.mjs",
    "check:experience": "node scripts/check-experience.mjs",
    "prebuild": "node scripts/ensure-rollup-native.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.158.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "wrangler": "^4.68.0"
  }
}
